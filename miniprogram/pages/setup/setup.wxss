.page { min-height: 100vh; padding: 28rpx 24rpx calc(42rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #f5f7f5; }
button::after { border: 0; }
.hero { padding: 6rpx 4rpx 26rpx; }.brand { display: flex; align-items: center; gap: 12rpx; color: #33423a; font-size: 23rpx; font-weight: 600; }.mark { width: 45rpx; height: 45rpx; line-height: 45rpx; text-align: center; border-radius: 15rpx; background: #16845e; color: #fff; font-size: 28rpx; }
.title { display: block; margin-top: 32rpx; color: #18231f; font-size: 42rpx; line-height: 1.28; font-weight: 700; letter-spacing: -1rpx; }.accent { color: #16845e; }.subtitle { display: block; margin-top: 15rpx; color: #68746d; font-size: 23rpx; line-height: 1.7; }
.status-card { display: flex; align-items: center; gap: 14rpx; margin: 8rpx 0 18rpx; padding: 19rpx 21rpx; border-radius: 20rpx; background: #fff; border: 1rpx solid #e6ece6; }.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #d4a449; }.status-card.ready .status-dot { background: #21a36d; }.status-title,.status-copy { display: block; }.status-title { font-size: 22rpx; font-weight: 650; }.status-copy { margin-top: 4rpx; color: #89938d; font-size: 19rpx; }
.card { margin-bottom: 18rpx; padding: 23rpx 21rpx; border: 1rpx solid #e6ece6; border-radius: 23rpx; background: #fff; }.section-title { display: flex; align-items: center; gap: 12rpx; color: #202d26; font-size: 25rpx; font-weight: 650; }.step { display: grid; place-items: center; width: 42rpx; height: 42rpx; border-radius: 14rpx; background: #e8f5ed; color: #16845e; font-size: 18rpx; }
.route { display: flex; justify-content: space-between; align-items: center; gap: 8rpx; margin-top: 20rpx; padding: 16rpx 15rpx; border-radius: 16rpx; background: #f6f9f6; color: #28362e; font-size: 22rpx; font-weight: 600; white-space: nowrap; }.arrow { color: #7b9c88; }.note { margin: 14rpx 1rpx; color: #76827b; font-size: 19rpx; line-height: 1.65; }.consent { display: flex; gap: 10rpx; align-items: flex-start; margin: 16rpx 0; color: #69756e; font-size: 18rpx; line-height: 1.55; }.consent checkbox { flex: none; transform: scale(.72); transform-origin: left top; margin-right: -8rpx; }
.primary { display: block; width: 100%; min-width: 0; margin: 16rpx 0 0; padding: 0 12rpx; box-sizing: border-box; height: 78rpx; line-height: 78rpx; border-radius: 19rpx; background: #16845e; color: #fff; font-size: 22rpx; font-weight: 650; }.primary[disabled] { opacity: .45; }.secondary { margin-top: 5rpx; background: #e8f5ed; color: #116d4d; }.invite-box { margin-top: 18rpx; padding: 15rpx; border-radius: 16rpx; background: #f6f9f6; }.invite-title { display: block; margin-bottom: 10rpx; font-size: 19rpx; font-weight: 600; overflow-wrap: anywhere; }.copy { display: block; width: 100%; min-width: 0; margin: 9rpx 0 0; padding: 0 16rpx; box-sizing: border-box; height: 62rpx; line-height: 62rpx; border-radius: 14rpx; background: #fff; color: #16845e; font-size: 19rpx; text-align: left; transition: background-color .18s ease, color .18s ease, transform .18s ease; }.copy-press { transform: scale(.985); background: #edf7f0; }.copy.is-copied { background: #e4f4e9; color: #116d4d; }.copy-feedback { margin-top: 10rpx; color: #16845e; font-size: 18rpx; line-height: 1.5; animation: copy-feedback-in .18s ease-out; }.tiny { display: block; margin-top: 12rpx; color: #8a958e; font-size: 17rpx; line-height: 1.5; }
.error-panel { margin-top: 13rpx; padding: 14rpx 16rpx; border: 1rpx solid #f0d8d3; border-radius: 14rpx; background: #fff5f2; }.error-title { display: block; color: #a64c3c; font-size: 18rpx; font-weight: 650; }.error-detail { display: block; margin-top: 6rpx; color: #80564f; font-size: 17rpx; line-height: 1.5; overflow-wrap: anywhere; }
.channel-card { margin-top: 15rpx; padding: 16rpx; border: 1rpx solid #e7ede8; border-radius: 16rpx; background: #fbfcfb; }.channel-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 12rpx; }.channel-title { display: block; color: #26352c; font-size: 21rpx; font-weight: 650; }.channel-id { display: block; margin-top: 5rpx; color: #929c95; font-size: 15rpx; overflow-wrap: anywhere; }.state-pill { flex: none; padding: 6rpx 12rpx; border-radius: 999rpx; background: #f5f0e4; color: #947034; font-size: 16rpx; }.state-pill.active { background: #e7f5eb; color: #16845e; }.state-pill.paused { background: #f1f2f0; color: #707a73; }.member-status { display: flex; align-items: center; gap: 10rpx; margin-top: 13rpx; padding: 11rpx 13rpx; border-radius: 12rpx; background: #f1f6f2; color: #53635a; font-size: 17rpx; }.member-state { color: #16845e; font-weight: 600; }.member-divider { color: #b3beb6; }.manage-button { margin-top: 12rpx; background: #f0f7f2; color: #167651; text-align: center; }
@keyframes copy-feedback-in { from { opacity: 0; transform: translateY(6rpx); } to { opacity: 1; transform: translateY(0); } }
.invite-input { height: 78rpx; margin-top: 21rpx; padding: 0 18rpx; box-sizing: border-box; border: 1rpx solid #e1e8e1; border-radius: 16rpx; background: #fbfcfb; font-size: 21rpx; }.privacy { display: flex; gap: 10rpx; padding: 7rpx 4rpx 0; color: #77837c; font-size: 18rpx; line-height: 1.6; }.lock { flex: none; color: #16845e; }.demo-link { display: block; margin: 17rpx auto 0; padding: 8rpx; background: transparent; color: #7f8b83; font-size: 20rpx; }.demo-link::after { border: 0; }
