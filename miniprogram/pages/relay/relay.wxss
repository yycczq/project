.page {
  height: 100vh;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 18rpx 22rpx 0;
  box-sizing: border-box;
  overflow: hidden;
  background: #f5f7f5;
}

button::after { border: 0; }

.route-card {
  flex: none;
  padding: 22rpx 22rpx 18rpx;
  background: #fff;
  border: 1rpx solid #e6ece6;
  border-radius: 22rpx;
  box-shadow: 0 5rpx 18rpx rgba(32, 57, 42, .035);
}
.route-head { display: flex; justify-content: space-between; align-items: center; color: #69756e; font-size: 21rpx; }
.state { padding: 7rpx 13rpx; border-radius: 30rpx; font-size: 18rpx; }
.state.on { color: #16845e; background: #e8f6ed; }
.state.off { color: #8b7771; background: #f1ece9; }
.route-line { display: flex; justify-content: space-between; align-items: center; gap: 8rpx; margin-top: 18rpx; color: #18231f; font-size: 23rpx; font-weight: 650; white-space: nowrap; }
.arrow { color: #91a39a; font-size: 22rpx; font-weight: 400; }
.route-meta { border-top: 1rpx solid #f0f3f0; margin-top: 17rpx; padding-top: 14rpx; color: #79857e; font-size: 18rpx; line-height: 1.45; }

.demo-row { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 10rpx; padding: 13rpx 4rpx; }
.demo-copy { flex: 1; min-width: 0; color: #738078; font-size: 19rpx; }
.demo-button { flex: none; width: auto; min-width: 0; margin: 0; padding: 0 14rpx; height: 54rpx; line-height: 54rpx; border-radius: 15rpx; color: #116d4d; background: #e8f5ed; font-size: 18rpx; }

.chat { flex: 1; min-height: 0; width: 100%; padding: 10rpx 0; box-sizing: border-box; }
.date { width: max-content; margin: 10rpx auto 22rpx; padding: 7rpx 15rpx; border-radius: 30rpx; background: #e9ede9; color: #818a84; font-size: 18rpx; }
.empty-state { max-width: 500rpx; margin: 15vh auto 0; padding: 28rpx 30rpx; text-align: center; }
.empty-mark { width: 68rpx; height: 68rpx; margin: 0 auto 16rpx; border-radius: 22rpx; background: #e6f3ea; color: #16845e; font-size: 38rpx; line-height: 68rpx; }
.empty-title { display: block; color: #334139; font-size: 23rpx; font-weight: 650; }
.empty-copy { display: block; margin-top: 9rpx; color: #89938d; font-size: 19rpx; line-height: 1.55; }

.message { display: flex; gap: 12rpx; align-items: flex-start; margin: 20rpx 0; }
.message.mine { flex-direction: row-reverse; }
.avatar { width: 54rpx; height: 54rpx; flex: none; display: flex; justify-content: center; align-items: center; border-radius: 18rpx; background: #dfe9e1; color: #3f6953; font-size: 20rpx; font-weight: 700; }
.mine .avatar { background: #d9eee2; color: #1b7753; }
.message-content { max-width: 78%; min-width: 0; display: flex; flex-direction: column; }
.sender { margin: 0 5rpx 7rpx; color: #8a938d; font-size: 18rpx; }
.mine .sender { text-align: right; }
.bubble { max-width: 100%; padding: 14rpx 18rpx; border: 1rpx solid #edf0ed; border-radius: 8rpx 20rpx 20rpx 20rpx; background: #fff; font-size: 23rpx; line-height: 1.5; overflow-wrap: anywhere; box-sizing: border-box; }
.mine .bubble { border-color: #d8eddf; border-radius: 20rpx 8rpx 20rpx 20rpx; background: #dff2e6; }
.message-text { white-space: pre-wrap; }
.photo { display: block; width: 400rpx; max-width: 100%; border-radius: 13rpx; }
.delivery,.relay-note { margin: 6rpx 5rpx 0; color: #849188; font-size: 17rpx; line-height: 1.4; }
.mine .delivery { text-align: right; }
.safety-note { margin: 18rpx auto; color: #95a098; font-size: 17rpx; line-height: 1.5; text-align: center; }

.composer {
  flex: none;
  margin: 0 -22rpx;
  padding: 14rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e9eeea;
  background: rgba(255, 255, 255, .98);
}
.route-hint { display: block; margin: 0 0 11rpx 3rpx; color: #7d8981; font-size: 18rpx; }
.compose-row { display: flex; width: 100%; align-items: center; gap: 10rpx; }
.image-button {
  display: flex;
  flex: 0 0 76rpx;
  justify-content: center;
  align-items: center;
  width: 76rpx;
  min-width: 76rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 1rpx solid #e2e9e3;
  border-radius: 21rpx;
  background: #fff;
  color: #54705f;
  font-size: 38rpx;
  line-height: 1;
}
.input {
  display: block;
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  height: 76rpx;
  margin: 0;
  padding: 0 17rpx;
  box-sizing: border-box;
  border: 1rpx solid #e2e9e3;
  border-radius: 20rpx;
  background: #fff;
  font-size: 21rpx;
}
.send-button {
  display: flex;
  flex: 0 0 106rpx;
  justify-content: center;
  align-items: center;
  width: 106rpx;
  min-width: 106rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #16845e;
  color: #fff;
  font-size: 21rpx;
  line-height: 1;
}
.send-button[disabled],.image-button[disabled] { opacity: .45; }
.bottom-row { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-top: 10rpx; color: #9aa49d; font-size: 16rpx; }
.bottom-row text { min-width: 0; }
.pause { flex: none; width: auto; min-width: 0; margin: 0; padding: 0 6rpx; color: #8a716d; background: transparent; font-size: 17rpx; }

@media (max-width: 350px) {
  .page { padding-left: 16rpx; padding-right: 16rpx; }
  .composer { margin-left: -16rpx; margin-right: -16rpx; padding-left: 14rpx; padding-right: 14rpx; }
  .route-card { padding-left: 17rpx; padding-right: 17rpx; }
  .route-line { font-size: 21rpx; }
  .image-button { flex-basis: 68rpx; width: 68rpx; min-width: 68rpx; }
  .send-button { flex-basis: 92rpx; width: 92rpx; min-width: 92rpx; }
}
